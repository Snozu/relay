# ─────────────────────────────────────────────────────────────
# Relay — copy this file to .env and fill it in. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# Which model provider Relay talks to: deepseek | anthropic | openai
RELAY_PROVIDER=deepseek
# Leave blank to use the provider default
# (deepseek-chat / claude-sonnet-5 / gpt-5.4-mini)
RELAY_MODEL=

# Only the key for the provider above is required.
# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Postgres. Matches docker-compose.yml for local development.
DATABASE_URL=postgresql://relay:relay@localhost:5440/relay?schema=public

# Public base URL of the deployment (used in the landing page and docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo guardrails — a public demo URL is effectively a public API key
RELAY_RATE_LIMIT_PER_MINUTE=12
RELAY_MAX_TOKENS_PER_DAY=2000000
