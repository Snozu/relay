# ─────────────────────────────────────────────────────────────
# Relay on a VPS — copy to deploy/.env and fill in. NEVER commit .env
# ─────────────────────────────────────────────────────────────

# Hostname Traefik routes to this deployment, and that host written as a URL.
# Set RELAY_RULE instead to answer on several hostnames at once, e.g.
#   RELAY_RULE=Host(`relay.example.com`) || Host(`old.example.net`)
RELAY_HOST=relay.example.com
RELAY_PUBLIC_URL=https://relay.example.com

# Traefik certificate resolver defined on the host. TLS-ALPN by default;
# a wildcard host needs a DNS-01 resolver instead.
RELAY_CERT_RESOLVER=mytlschallenge

# Postgres. Local to this deployment, never exposed; generate the password
# with `openssl rand -base64 24`.
POSTGRES_USER=relay
POSTGRES_DB=relay
POSTGRES_PASSWORD=

# Model provider used when a visitor supplies no key of their own.
# deepseek | anthropic | openai
RELAY_PROVIDER=deepseek
RELAY_MODEL=

# Guardrails. A public demo URL is effectively a public API key.
RELAY_RATE_LIMIT_PER_MINUTE=12
RELAY_MAX_TOKENS_PER_DAY=2000000

# Fallback credentials. Only the key matching RELAY_PROVIDER above is read.
#
# Left blank, the deployment holds no credentials of its own and the console
# asks each visitor for a key, which stays in their browser. Filled in, anyone
# with the URL can run the demo without a key — and every token is billed to
# you. Cap the spend at the provider as well; RELAY_RATE_LIMIT_PER_MINUTE is
# per IP, not per wallet.
#
# This file is committed. The real one is not — never paste a key here.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
