# Anything the image does not need, and everything it must never contain.
node_modules
.next
.git
.github
tsconfig.tsbuildinfo
npm-debug.log*

# Secrets and internal material. This repo is public; the image is not a
# reason to relax that.
.env
.env.*
!.env.example
private
CLAUDE.md
.claude

# Build artefacts of the case studies — megabytes of PDF the server never reads.
docs/**/*.pdf

.DS_Store
